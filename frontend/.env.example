# ==============================================================================
# ARGUS PRISM - Frontend Studio Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `frontend/.env.local` for local Next.js development:
#   cp .env.example .env.local
# In cloud deployments (e.g. Render, Vercel), set these in the dashboard.
# All URLs use dummy placeholder domains.
# ==============================================================================

# URL of the deployed or local ARGUS PRISM FastAPI backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# URL of the Streamlit visual telemetry dashboard
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:8501

# Canonical repository URL for dynamic badges and references
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/your-username/argus-prism

# Sample preset audit URLs
NEXT_PUBLIC_SAMPLE_URL_SOUND=https://example.com/tutorial
NEXT_PUBLIC_SAMPLE_URL_DEPRECATED=https://example.com/docs
NEXT_PUBLIC_SAMPLE_URL_UNVERIFIED=https://example.com/spec

# Verification citations
NEXT_PUBLIC_CITATION_URL_1=https://example.com/async
NEXT_PUBLIC_CITATION_URL_2=https://example.com/latest
NEXT_PUBLIC_CITATION_URL_3=https://example.com/releases/v2
NEXT_PUBLIC_CITATION_URL_4=https://example.com/releases/v2
