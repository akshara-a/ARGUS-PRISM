# ==============================================================================
# ARGUS PRISM - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` for local backend development:
#   cp .env.example .env
# All credentials and endpoints use dummy placeholder values to prevent disclosure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Search Engine Providers & Telemetry Streams
# ------------------------------------------------------------------------------
DEFAULT_SEARCH_PROVIDER=duckduckgo
ARGUS_MOCK_FALLBACK=true

# SerpApi Strategy (Optional)
SERPAPI_API_KEY=your_serpapi_api_key_here
SERPAPI_ENDPOINT=https://api.example.com/search.json

# DuckDuckGo Lite Strategy (Free, zero-key HTML search endpoint)
DUCKDUCKGO_ENDPOINT=https://lite.example.com/lite/
DUCKDUCKGO_REFERER=https://lite.example.com/

# ------------------------------------------------------------------------------
# 2. Local Open-Weight LLM (Google Gemma 2 via Ollama)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_GENERATE_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_TAGS_ENDPOINT=http://localhost:11434/api/tags
GEMMA_MODEL_NAME=gemma2:2b

# ------------------------------------------------------------------------------
# 3. Backboard Open-Weight Multi-Model Triangulation (Optional)
# ------------------------------------------------------------------------------
BACKBOARD_API_KEY=your_backboard_api_key_here
BACKBOARD_ENDPOINT=https://api.example.com/v1/chat/completions

# ------------------------------------------------------------------------------
# 4. Spoken Audio Debriefs & Voice Personas (ElevenLabs)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_API_ENDPOINT=https://api.example.com/v1/text-to-speech/{voice_id}
ELEVENLABS_VOICE_ID=dummy_default_voice_id
ELEVENLABS_VOICE_RACHEL=dummy_rachel_voice_id
ELEVENLABS_VOICE_ADAM=dummy_adam_voice_id
ELEVENLABS_VOICE_DREW=dummy_drew_voice_id

# ------------------------------------------------------------------------------
# 5. Core Engine & Deterministic Scoring Parameters
# ------------------------------------------------------------------------------
ARGUS_LOG_LEVEL=INFO
ARGUS_DEFAULT_LAMBDA=0.15
ARGUS_RECURSION_LIMIT=1
ARGUS_API_BASE_URL=http://127.0.0.1:8000
ARGUS_REPO_URL=https://github.com/your-username/argus-prism

# ------------------------------------------------------------------------------
# 6. Sentry Distributed Tracing & Observability
# ------------------------------------------------------------------------------
SENTRY_DSN=https://dummy_key@o0.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# 7. Network, CORS & Cloud Server Ports
# ------------------------------------------------------------------------------
ARGUS_HOST=0.0.0.0
ARGUS_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=https://.*\.example\.com

# Streamlit Telemetry Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
